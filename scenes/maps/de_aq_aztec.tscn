[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_aztec_wood"]
resource_name = "aztec.bridge.wood"
albedo_color = Color(0.42, 0.3, 0.19, 1)
roughness = 0.85

; Water is the one translucent surface in the blockout. Per-pixel transparency
; is forbidden on default materials (AGENTS.md rule 4 / ARCHITECTURE.md §1), so
; this uses alpha-scissor (discard) instead. TODO(m4): the "translucent blue"
; water look really wants a dedicated alpha-blended shader on its own pass —
; park it until the shader lint pass exists.
[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_aztec_water"]
resource_name = "aztec.water.canal"
transparency = 2
alpha_scissor_threshold = 0.5
albedo_color = Color(0.18, 0.42, 0.6, 0.55)
metallic = 0.2
roughness = 0.15

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_aztec_foliate"]
