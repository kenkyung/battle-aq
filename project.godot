[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Players"
3d_physics/layer_3="Projectiles"

[physics]

3d/default_gravity=24.0

[networking]

; ENet is the default; explicitly bind a high-rate reliable channel for state.
network/max_clients=16