[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Players"
3d_physics/layer_3="Projectiles"

[networking]

network/max_clients=16

[physics]

3d/default_gravity=24.0

[rendering]

; In project.godot the SECTION is the first path segment: `[rendering]` +
; `renderer/rendering_method` is the setting `rendering/renderer/rendering_method`.
; Writing the full path as the key here yields
; `rendering/rendering/renderer/...`, which is not a real setting and is
; silently ignored — Godot then keeps its `forward_plus` default. That mistake
; shipped once: `tools/diagnose.gd` reported "renderer (configured) :
; forward_plus" while this file appeared to ask for gl_compatibility.
renderer/rendering_method="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=0
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
scaling_3d/mode=0
scaling_3d/scale=1.0
