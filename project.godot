; Engine configuration file.
; Multiplayer FPS scaffold built on Godot 4.x — mobile-first renderer so it
; runs on modest hardware (iGPU laptops, Steam Deck, low-end Android).
; Networking: built-in ENet (peer-to-peer w/ optional dedicated host).

config_version=5

[application]

config/name="Battle-AQ"
config/description="Lightweight online multiplayer FPS inspired by Counter-Strike."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/per_pixel_transparency/enabled=false
window/size/window_width_override=1280
window/size/window_height_override=720
; Mobile renderer: GL Compatibility + small 3D + no MSAA -> wide hardware support.
rendering/renderer=rendering_driver/opengl3
rendering/textures/default_filters/anisotropic_filtering_level=0
rendering/anti_aliasing/quality/msaa_3d=0
rendering/anti_aliasing/quality/screen_space_aa=0
rendering/scaling_3d/mode=0
rendering/scaling_3d/scale=1.0

[input]

; Standard FPS controls — names match Player.gd lookups.
move_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
